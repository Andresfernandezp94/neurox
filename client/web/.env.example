# Plantilla de variables de build del panel.
#
# Copiala a `.env` y ajustá lo que necesites:
#     cp .env.example .env
#
# `.env` está en `.gitignore`: las preferencias de cada máquina no se
# versionan. Esta plantilla sí, para que se sepa qué variables existen.

# Modo mock de neurox-web.
#
# Con VITE_NEUROX_MOCK=true la UI se hidrata con datos de
# `src/shared/mock/mockData.ts` en vez de pegarle al daemon, y el
# BootLoader no espera red. Sirve para diseñar la página sin backend.
#
# Con `false` (o la línea ausente) la web lee todo del daemon real.
VITE_NEUROX_MOCK=false

# Base del daemon para el build de PRODUCCIÓN.
#
# Vacío = same-origin: el browser pide /v1/* al mismo host que sirve la
# SPA. Es lo correcto cuando todo vive detrás de un proxy inverso
# (nginx, Caddy, neurox-web en :8787, o el dev server de vite en :5173,
# que ya proxea /v1 hacia 127.0.0.1:7878).
#
# Conviene dejarlo VACÍO mientras desarrollás. Solo poné una URL
# absoluta cuando la SPA se sirve desde un origen que NO tiene /v1/* —
# por ejemplo un deploy en Cloudflare Pages, donde sí hace falta
# `VITE_API_BASE=https://mcp.neurox.pro`.
#
# OJO: es una variable de BUILD TIME (Vite la inlina en el bundle).
# Cambiarla acá exige rebuildear; no tiene efecto con HMR.
VITE_API_BASE=

# Declara que este build se sirve detrás de neurox-web, que proxea /v1/*
# hacia el daemon. Con VITE_API_BASE vacío y esta variable a true, el
# guard de `src/api/client.ts` no salta: same-origin es el modo correcto
# en ese despliegue y no debe hornearse ninguna IP en el bundle.
#
# Ponéla en true para el despliegue local detrás de neurox-web, y en
# false (o ausente) para un deploy donde el origen no tenga /v1/*, que
# es cuando el guard debe seguir fallando ruidosamente.
VITE_SAME_ORIGIN_PROXY=true